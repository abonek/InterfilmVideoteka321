@model WebApplication1.Models.LoginModel
@{
    ViewData["Title"] = "Prijava";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h2>Prijava</h2>
        <p class="subtitle">Unesite vaše podatke za pristup računu.</p>

        <form asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert-danger"></div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="vas@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Lozinka</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary" style="width:100%;">Prijavi se</button>
        </form>

        <div class="auth-footer">
            Nemate račun? <a href="@Url.Action("Register", "Home")">Registrirajte se</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
